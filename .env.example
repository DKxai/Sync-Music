# COPY to .env; generate random values before starting.
APP_API_KEY=REPLACE_WITH_LONG_RANDOM_TOKEN
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
MUSIC_SYNC_PORT=8787
DATA_DIR=/data
SPOTIFY_POLL_MINUTES=5
YTM_POLL_MINUTES=10
APPLE_POLL_MINUTES=10
DELETE_MODE=auto
DELETE_CONFIRM_POLLS=2
MAX_DELETE_PERCENT=5
MAX_DELETE_ABSOLUTE=20
# Safety: keep writes off until baseline/mapping and dry-run audits pass.
WRITE_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/v1/auth/spotify/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_STOREFRONT=vn
