# Botkeep native Python profile (Environment tab; do not commit live .env)
# APP_API_KEY and ENCRYPTION_KEY must be generated and stored privately.
APP_API_KEY=REPLACE_WITH_RANDOM_32_CHAR_OR_LONGER_KEY
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SPOTIFY_POLL_MINUTES=5
YTM_POLL_MINUTES=10
APPLE_POLL_MINUTES=10
DELETE_MODE=auto
DELETE_CONFIRM_POLLS=2
MAX_DELETE_PERCENT=5
MAX_DELETE_ABSOLUTE=20
WRITE_ENABLED=false
AUTO_TRANSFER_ENABLED=false
APPLE_STOREFRONT=vn
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
APPLE_WEB_ORIGIN=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_FAVORITES_PLAYLIST_ID=
# SERVER_PORT is assigned by Botkeep. Do not set DATA_DIR=/data here.
